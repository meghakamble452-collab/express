<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>Express</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>11.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>ExpressLogo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="NEXUS.Extention.irctc.p12" />
    <None Remove="NEXUS.Booking.IPayBinResolver.txt" />
    <None Remove="NEXUS.Extention.Beta.dll" />
    <None Remove="NEXUS.Extention.data.dll" />
    <None Remove="NEXUS.Extention.BhimAXIS.dll" />
    <None Remove="NEXUS.Extention.SQLite.dll" />
    <None Remove="NEXUS.Extention.Ionic.Zip.Reduced.dll" />
    <None Remove="NEXUS.Extention.PhonePeCSharp.dll" />
    <None Remove="NEXUS.Extention.Driver.dll" />
    <None Remove="NEXUS.Extention.BhimSBI.dll" />
    <None Remove="NEXUS.Extention.MReget.dll" />
    <None Remove="NEXUS.Extention.CaptchaRecog.dll" />
    <None Remove="NEXUS.Extention.NewCaptchaRecog.dll" />
    <None Remove="NEXUS.Extention.XCaptchaRecog.dll" />
    <None Remove="NEXUS.Extention.NpciPay.dll" />
    <None Remove="NEXUS.Extention.FreeCharge.dll" />
	  <Content Include="ExpressLogo.ico">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="express-logo.png">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
    <EmbeddedResource Include="NEXUS.Extention.irctc.p12" LogicalName="NEXUS.Extention.irctc.p12" />
    <EmbeddedResource Include="NEXUS.Booking.IPayBinResolver.txt" LogicalName="NEXUS.Booking.IPayBinResolver.txt" />
    <EmbeddedResource Include="NEXUS.Extention.Beta.dll" LogicalName="NEXUS.Extention.Beta.dll" />
    <EmbeddedResource Include="NEXUS.Extention.data.dll" LogicalName="NEXUS.Extention.data.dll" />
    <EmbeddedResource Include="NEXUS.Extention.BhimAXIS.dll" LogicalName="NEXUS.Extention.BhimAXIS.dll" />
    <EmbeddedResource Include="NEXUS.Extention.SQLite.dll" LogicalName="NEXUS.Extention.SQLite.dll" />
    <EmbeddedResource Include="NEXUS.Extention.Ionic.Zip.Reduced.dll" LogicalName="NEXUS.Extention.Ionic.Zip.Reduced.dll" />
    <EmbeddedResource Include="NEXUS.Extention.PhonePeCSharp.dll" LogicalName="NEXUS.Extention.PhonePeCSharp.dll" />
    <EmbeddedResource Include="NEXUS.Extention.Driver.dll" LogicalName="NEXUS.Extention.Driver.dll" />
    <EmbeddedResource Include="NEXUS.Extention.BhimSBI.dll" LogicalName="NEXUS.Extention.BhimSBI.dll" />
    <EmbeddedResource Include="NEXUS.Extention.MReget.dll" LogicalName="NEXUS.Extention.MReget.dll" />
    <EmbeddedResource Include="NEXUS.Extention.CaptchaRecog.dll" LogicalName="NEXUS.Extention.CaptchaRecog.dll" />
    <EmbeddedResource Include="NEXUS.Extention.NewCaptchaRecog.dll" LogicalName="NEXUS.Extention.NewCaptchaRecog.dll" />
    <EmbeddedResource Include="NEXUS.Extention.XCaptchaRecog.dll" LogicalName="NEXUS.Extention.XCaptchaRecog.dll" />
    <EmbeddedResource Include="NEXUS.Extention.NpciPay.dll" LogicalName="NEXUS.Extention.NpciPay.dll" />
    <EmbeddedResource Include="NEXUS.Extention.FreeCharge.dll" LogicalName="NEXUS.Extention.FreeCharge.dll" />

  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
    <PackageReference Include="System.Reactive" Version="4.4.1" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
